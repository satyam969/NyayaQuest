# ─────────────────────────────
# LLM
# ─────────────────────────────
GROQ_API_KEY=

# ─────────────────────────────
# Firebase Auth
# ─────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────
# Vector Store Artifact
# ─────────────────────────────
GOOGLE_DRIVE_ARTIFACT_ID=
CHROMA_PERSIST_DIR=./chroma_db_groq_legal

# ─────────────────────────────
# Cache
# ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────
# Security
# ─────────────────────────────
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
ADMIN_EMAILS=your-email@example.com
ADMIN_API_KEY=

# ─────────────────────────────
# Intent Router
# ─────────────────────────────
# Threshold for heuristic classification confidence.
# Below this, LLM classifier is called.
# Range: 0.0 to 1.0. Default: 0.70
CLASSIFICATION_THRESHOLD=0.70

# ─────────────────────────────
# Observability
# ─────────────────────────────
SENTRY_DSN=
ENVIRONMENT=production
GIT_COMMIT=
LOG_LEVEL=INFO
